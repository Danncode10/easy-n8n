# N8N Environment Variables
# Copy this file to .env and modify as needed
# This file is NOT tracked by git (see .gitignore)

# ===== Server Configuration =====

# Port where N8N will run (default: 5678)
# N8N_PORT=5678

# Host binding
# 0.0.0.0 - accessible from any network interface (local access)
# localhost or 127.0.0.1 - only accessible from this machine
# N8N_HOST=0.0.0.0

# ===== Authentication =====

# Enable basic authentication (true/false, default: false)
# N8N_BASIC_AUTH_ACTIVE=false

# Basic auth username (required if N8N_BASIC_AUTH_ACTIVE=true)
# N8N_BASIC_AUTH_USER=admin

# Basic auth password (required if N8N_BASIC_AUTH_ACTIVE=true)
# N8N_BASIC_AUTH_PASSWORD=your-secure-password

# ===== Data Encryption =====

# Encryption key for sensitive data (auto-generated if not set)
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# N8N_ENCRYPTION_KEY=your-encryption-key-here

# ===== Database =====

# User data folder location (default: ~/.n8n)
# This stores workflows, credentials, and user data
# N8N_USER_FOLDER=/path/to/custom/folder

# Database type (default: sqlite)
# Supported: sqlite, postgres, mysql, mariadb
# N8N_DB_TYPE=sqlite

# For PostgreSQL:
# N8N_DB_POSTGRESDB_HOST=localhost
# N8N_DB_POSTGRESDB_PORT=5432
# N8N_DB_POSTGRESDB_DATABASE=n8n
# N8N_DB_POSTGRESDB_USER=postgres
# N8N_DB_POSTGRESDB_PASSWORD=password

# ===== Logging =====

# Log level (default: info)
# Options: debug, info, warn, error
# N8N_LOG_LEVEL=info

# ===== JWT Configuration =====

# JWT secret key (auto-generated if not set)
# N8N_JWT_SECRET=your-jwt-secret

# ===== Node Settings =====

# Allow external API calls (default: false)
# N8N_ALLOW_EXTERNAL_WEBHOOKS=false

# ===== Advanced Settings =====

# Disable dashboard (default: false)
# N8N_DISABLE_PRODUCTION_MAIN_PROCESS=false

# Custom webhook URL (for testing webhooks)
# N8N_WEBHOOK_URL=http://localhost:5678

# Timezone (default: UTC)
# N8N_TIMEZONE=UTC

# ===== Development =====

# Development mode (for N8N developers only)
# NODE_ENV=development

# Log SQL queries (debug mode)
# N8N_LOG_LEVEL=debug

# ===== Notes =====
#
# 1. Uncomment variables you want to use by removing the # at the start
# 2. For security, never commit real credentials or passwords to git
# 3. After modifying this file, restart N8N for changes to take effect
# 4. Boolean values should be: true, false, 1, or 0
# 5. Passwords with special characters should be quoted: "my!p@ss"
#
